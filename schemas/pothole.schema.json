{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detector-baches.local/schemas/pothole.schema.json",
  "title": "Persistent pothole",
  "description": "Entidad persistente formada por observaciones compatibles de uno o más viajes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pothole_id",
    "observation_ids",
    "latitude",
    "longitude",
    "association_version"
  ],
  "properties": {
    "pothole_id": { "type": "string", "minLength": 1 },
    "observation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "road_segment_id": { "type": ["string", "null"] },
    "association_version": { "type": "string", "minLength": 1 }
  }
}
